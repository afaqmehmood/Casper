        "template--18952594129217__38ff978b-66eb-4318-9ce0-94db8ff86311-1683126238ada0cf52-1": {
          "type": "text_block",
          "settings": {
            "image": "shopify://shop_images/Red_clay_linen_Cloud_Dog_Bed.jpg",
            "title": "Cloud-like Memory Foam with Cooling Gel Topper",
            "text": "<p>The mattress combines a layer of CertiPUR-US® certified orthopedic foam with cooling gel memory foam, delivering soft, cloud-like comfort. These layers provides joint joint support, enhanced breathability, and a softer feel that’s ideal for small to medium dogs.</p>",
            "button_text": "",
            "button_link": "",
            "button_color": "btn--black",
            "button_style": "btn--text",
            "button_size": "btn--small",
            "video_link_popup": "",
