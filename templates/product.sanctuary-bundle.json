        "text_block_irPkWL": {
          "type": "text_block",
          "settings": {
            "image": "shopify://shop_images/Cloud_Bed_-_Sleep_Cloud-2.jpg",
            "title": "Contouring memory foam pillow",
            "text": "<p>Unlike other firm, high bolster beds, our thoughtfully designed pillow features a gentle, lower profile that offers a soft plush experience for small to medium dogs. This ensures they can rest comfortably without awkward neck positioning, promoting better posture and a truly restful slumber.</p>",
            "button_text": "",
            "button_link": "",
            "button_color": "btn--black",
            "button_style": "btn--text",
            "button_size": "btn--small",
