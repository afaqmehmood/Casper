        "text_block_dxJL6f": {
          "type": "text_block",
          "settings": {
            "image": "shopify://shop_images/Sofa_topper_Dove_Grey_Chewy.jpg",
            "title": "Thick, Durable Upholstery Fabric",
            "text": "<p>Thick enough to resist pet claws when they love to dig and scratch. Our Sofa Toppers are made from a heavyweight upholstery-grade cotton-linen blend. </p>",
