          "settings": {
            "image": "shopify://shop_images/Sofa_topper_milk_linen_cotton_winston_and_bailey.jpg",
            "title": "Machine Washable",
            "text": "<p>Covers are machine washable for easy care. Simply unzip, remove, and wash on a gentle cool cycle to keep it fresh and clean.</p>",
