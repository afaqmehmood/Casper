    "section_text_gEE8Dh": {
      "type": "section-text",
      "blocks": {
        "heading_bVeRqP": {
          "type": "heading",
          "settings": {
            "text": "<p>Flexible & Versatile Use</p>",
            "size": 90,
            "heading_highlight_type": "italics",
            "highlight_color": "#d43747",
            "highlight_text_color": "#000000"
          }
        },
        "text_9CXWHB": {
          "type": "text",
          "settings": {
            "text": "<p>Our Sofa Toppers offer unmatched versatility beyond standard couch covers. Use it across your sofa base, fold it for smaller areas, drape over armrests, or position vertically for L-shaped sofas or lounge chairs.</p><p><br/>Practical and breathable, it also works as a bed throw, travel mat, or cosy floor topper—giving your dog a familiar, comfortable surface wherever you go.</p>",
            "size": 100
          }
        }
      },
      "block_order": [
        "heading_bVeRqP",
        "text_9CXWHB"
      ],
      "disabled": true,
      "settings": {
        "text_position": "center",
