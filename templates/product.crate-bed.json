      "type": "section-text",
      "blocks": {
        "heading_pt8te7": {
          "type": "heading",
          "settings": {
            "text": "<p><strong>The Ultimate Luxury Dog Crate Bed for Pet Parents Who Love Interior Design</strong></p>",
            "size": 90,
            "heading_highlight_type": "italics",
            "highlight_color": "#d43747",
            "highlight_text_color": "#000000"
          }
        },
        "text_cYrV3D": {
          "type": "text",
          "settings": {
            "text": "<p>Designed to fit seamlessly inside your dog's crate, our bed offers plush, joint-supportive cooling gel memory foam. Lightweight and portable, it transitions effortlessly between crate and living space, while its stylish modern design complements the aesthetics of your home.</p>",
            "size": 100
          }
        }
      },
