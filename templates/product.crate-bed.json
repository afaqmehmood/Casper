    "section_columns_L4wJ3W": {
      "type": "section-columns",
      "blocks": {
        "text_block_AT9GKz": {
          "type": "text_block",
          "settings": {
            "image": "shopify://shop_images/flat_bed_khaki_logo.jpg",
            "title": "Premium Upholstery Linen & Boucle Fabrics",
            "text": "<p>Our linen covers are available in two luxurious, heavyweight upholstery fabrics: linen and boucle, both OEKO-TEX Standard 100 certified. This collection showcases a natural, earthy color palette, offering a refined aesthetic with a soft, sumptuous feel that complements any home decor.</p>",
            "button_text": "",
            "button_link": "",
            "button_color": "btn--black",
            "button_style": "btn--text",
            "button_size": "btn--small",
            "video_link_popup": "",
            "video_link_color": "text-dark"
          }
        },
        "text_block_fgVdtH": {
          "type": "text_block",
          "settings": {
            "image": "shopify://shop_images/Denim_Blue_Flat_Bed.jpg",
            "title": "Orthopaedic Memory Foam - with Cooling Gel",
            "text": "<p>Our foam is <a href=\"http://www.certipur.us/\" title=\"CertiPUR-US®\">CertiPUR-US®</a> certified, providing orthopaedic joint support that's just the right balance for small and medium dogs. Topped with a cooling gel memory foam for a temperature regulating and contouring layer for ultimate comfort.</p>",
            "button_text": "",
            "button_link": "",
            "button_color": "btn--black",
            "button_style": "btn--text",
            "button_size": "btn--small",
            "video_link_popup": "",
            "video_link_color": "text-dark"
          }
        },
        "text_block_Mxa9Xt": {
          "type": "text_block",
          "settings": {
            "image": "shopify://shop_images/KOOZI-CAMPAIGN-186_2.jpg",
            "title": "Minimalist and Versatile Design",
            "text": "<p>Featuring a sleek, versatile design, this bed seamlessly blends with your home interiors. Use it as a classic dog bed, a cosy dog cushion, a travel dog bed or place it inside the Koozi Side Table Crate or any dog crate of your choice.</p>",
            "button_text": "",
            "button_link": "",
            "button_color": "btn--black",
            "button_style": "btn--text",
            "button_size": "btn--small",
            "video_link_popup": "",
            "video_link_color": "text-dark"
          }
        }
