    "section_icons_row_VzcmJc": {
      "type": "section-icons-row",
      "blocks": {
        "text_R4GRYN": {
          "type": "text",
          "settings": {
            "icon_name": "gem",
            "title": "Effortlessly Stylish & Practical",
            "text": "<p>The inherent texture of linen provides a casual yet sophisticated appearance, creating a relaxed vibe that complements various decor styles. When combined with performance fabric, our covers deliver understated elegance while ensuring durability and practicality.</p>"
          }
        },
        "text_dDJ9hE": {
          "type": "text",
          "settings": {
            "icon_name": "paw-heart",
            "title": "Breathable + Temperature Regulating",
            "text": "<p>Linen is naturally breathable, promoting air circulation and moisture evaporation to keep your dog cool in warm weather, while also offering insulation in cooler weather.</p>"
          }
        },
        "text_ze4YCR": {
          "type": "text",
          "settings": {
            "icon_name": "check",
            "title": "Thick and Durable",
            "text": "<p>Linen is naturally strong, and when blended with upholstery-grade polyester, it becomes even more durable and resistant to wear and tear, extending the lifespan of your dog's bed cover.</p>"
          }
        },
        "text_TnTwKU": {
          "type": "text",
          "settings": {
            "icon_name": "eco-friendly",
            "title": "Stays Naturally Fresh",
            "text": "<p>Linen's natural hypoallergenic properties help reduce irritants, making it a safer choice for sensitive dogs. Its antibacterial qualities may inhibit bacterial growth, keeping the bed cleaner and fresher. The texture also reduces pet hair from static sticking.</p>"
          }
        }
      },
