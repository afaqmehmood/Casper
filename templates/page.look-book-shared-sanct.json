    "section_text_CMfipT": {
      "type": "section-text",
      "blocks": {
        "text_atFx3U": {
          "type": "text",
          "settings": {
            "text": "<p><strong>The Shared Sanctuary Collection</strong> celebrates the bond you share with your dog, creating spaces where both of you can truly feel at home - your sanctuaries. Designed to enhance your shared living spaces, each piece effortlessly blends style with thoughtful comfort, solving real problems along the way.</p><p><br/>With a focus on natural fabrics, durable materials, and elevated neutral and organic tones, this collection transforms your home into a retreat - elegant for you and  serene for your dog. It’s a celebration of connection, making every space as stylish as it is inviting for the furry ones you love.</p>",
            "size": 95
          }
        }
      },
      "block_order": [
        "text_atFx3U"
