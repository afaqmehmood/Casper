    "accordion-section-2": {
      "type": "section-accordions",
      "blocks": {
        "accordion_block_2_0": {
          "type": "text",
          "settings": {
            "title": "I've placed my order, when will it now ship?",
            "text": "<p>All in-stock items ship within 1-2 business days. Orders placed on weekends are processed the next business day or the following day if Monday is a holiday.</p><p>We will send you an email with a tracking number once your item is dispatched.</p>"
          }
        },
        "accordion_block_2_1": {
          "type": "text",
          "settings": {
            "title": "How long is delivery?",
            "text": "<p>Most orders typical arrive within 2-10 business days, depending on your location in Australia.</p>"
          }
        },
        "accordion_block_2_2": {
          "type": "text",
          "settings": {
            "title": "Is shipping free?",
            "text": "<p><strong>Enjoy Complimentary Standard Delivery - for a limited time only.</strong></p><ul><li>Orders are dispatched from our Sydney warehouse within 1 - 2 business days.</li><li>Delivery time typically is between 2 - 10 business days, depending on your location.</li><li>We will send your tracking number once order is dispatched.<br/><br/></li></ul><p><strong>For the Koozi Side Table Crate:</strong></p><ul><li><strong>Greater Sydney / Hunter / Illawarra Region</strong>: Enjoy free delivery and assembly. Our team will reach out to schedule delivery and assemble the crate in your preferred room.</li><li><strong>Interstate Customers</strong>: Fast free delivery<em> (for a limited time) </em>Australia-wide.</li></ul>"
          }
        },
        "accordion_block_2_4": {
          "type": "text",
          "settings": {
            "title": "How do I track my order?",
            "text": "<p>When your order is shipped, you will receive an email containing tracking information with a link to follow your order. </p><p>You may always contact the Koozi team or our courier partner for questions regarding your shipment.</p>"
          }
        },
        "text_D4anEm": {
          "type": "text",
          "settings": {
            "title": "I need to change my delivery address",
            "text": "<p>If you have just placed your order and need to change the delivery address, please email ASAP to help@koozipets.com.au. </p><p>We’ll do our best to accommodate changes, but once your order is dispatched and with the courier, adjustments become more difficult. Please reach out to us as soon as possible for the best chance of making any changes.</p>"
          }
        },
        "text_Vrhwgw": {
          "type": "text",
          "settings": {
            "title": "Do you ship to PO Boxes?",
            "text": "<p>No, we cannot ship to PO Boxes. Please do not use a PO Box address at checkout. </p>"
          }
        },
        "text_cNNkFR": {
          "type": "text",
          "settings": {
            "title": "Where do you ship from?",
            "text": "<p>We ship from our warehouse in Sydney, NSW.</p>"
          }
        },
        "text_MVHxKg": {
          "type": "text",
          "settings": {
            "title": "Do I need to be home for delivery?",
            "text": "<p>For standard delivery, we can leave your package in a safe spot if you're not home.</p><p>For larger furniture items, like our Side Table Dog Crate, the courier will coordinate with you to arrange re-delivery at the next available date if no one is home.</p>"
          }
        }
      },
