    "section_accordions_3dEJmQ": {
      "type": "section-accordions",
      "blocks": {
        "text_WGwEi3": {
          "type": "text",
          "settings": {
            "title": "How can I contact customer service?",
            "text": "<p>If you would like to speak to a member of our team, please email us at hello@koozipets.com.au.</p>"
          }
        },
        "text_fcaMhG": {
          "type": "text",
          "settings": {
            "title": "How do pre-orders work?",
            "text": "<p>If an item is currently out of stock, you can still place a pre-order! Instead of the usual 'Add to Cart' button, you'll see a 'Pre-order' button on the product page. Alongside, we'll provide an estimated restock date so you know when your order will be fulfilled.</p><p>You can proceed with checkout as usual, and we'll keep you updated as soon as your item is back in stock and ready for dispatch.</p>"
          }
        },
        "text_66pynJ": {
          "type": "text",
          "settings": {
            "title": "Do you offer any discount offers?",
            "text": "<p><strong>20% Summer Sale Now On<br/></strong>During February, take 20% off everything plus enjoy free shipping Australia wide. </p><p><strong>Buy a Side Table Dog Crate, get a FREE Flat Bed (For a limited time)</strong><br/>For a limited time, receive a complimentary Flat Bed with every Side Table Dog Crate purchase. <br/><em>Discount is</em> <em>automatically applied to the cart when both items are added.</em></p><p><strong>Koozi Community - First Order 10% Gift Code</strong><br/>Welcome to the Koozi Community! Enjoy a special 10% gift code on your first order by subscribing via the sign-up form in the pop up or in our footer. <br/><em>This discount applies to full-priced items only, and cannot be combined with other offers.</em></p><p><strong>Buy Any 2+ Items, Get 20% Off</strong><br/>Purchase any two or more items (in any colour or size) and enjoy 20% off. <em>Discount is automatically applied at checkout.  </em></p><p><strong>Free Shipping on All Orders</strong><br/>Enjoy complimentary standard shipping on every purchase—no discount code needed. <em>Automatically applied at checkout.<br/><br/>Please note: discounts cannot be combined with other offers. </em></p>"
          }
        },
        "text_QntX7b": {
          "type": "text",
          "settings": {
            "title": "Can I pick up from the warehouse?",
            "text": "<p>Yes, it can be arranged for you to collect your Koozi order from our Warehouse. If you tick this option, we will arrange it with you via email.</p>"
          }
        }
      },
