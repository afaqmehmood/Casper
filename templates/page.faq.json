    "accordion-section-1": {
      "type": "section-accordions",
      "blocks": {
        "accordion_block_1_1": {
          "type": "text",
          "settings": {
            "title": "How do I place an order?",
            "text": "<p>Simply click the \"Add to Cart\" button on any product you'd like to purchase. When you're ready to complete your order, click the cart icon in the top right corner of your screen, review your items, and follow the checkout prompts to finalise your purchase.</p>"
          }
        },
        "accordion_block_1_2": {
          "type": "text",
          "settings": {
            "title": "I'm having an issue adding to cart or at checkout",
            "text": "<p>If you encounter any issues adding items to your cart, try removing them, refreshing the page, and adding them again. </p><p>For checkout issues, ensure all information is filled out correctly and your payment method is valid.</p><p> If either problem persists, get in touch with us as soon as possible at <a>help@koozipets.com.au</a>, and we'll resolve it for you.</p>"
          }
        },
        "accordion_block_1_3": {
          "type": "text",
          "settings": {
            "title": "How do I know you received my order?",
            "text": "<p>After successfully placing your order, you will receive a confirmation email detailing your purchased items, delivery costs, and shipping address. Please check your junk folder as well, as confirmation emails can sometimes end up there. <br/><br/>Within 2 business days, you will receive a separate email outlining the delivery process and any relevant lead times.<br/><br/> If you do not receive your order confirmation email within one hour, please contact us at help@koozipets.com.au. </p>"
          }
        },
        "accordion_block_1_4": {
          "type": "text",
          "settings": {
            "title": "What forms of payment do you accept?",
            "text": "<p>We accept payments from major credit card companies like Visa, Mastercard, and American Express. We also accept Apple Pay and Google Pay and Paypal. </p>"
          }
        }
      },
