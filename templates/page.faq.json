    "accordion-section-3": {
      "type": "section-accordions",
      "blocks": {
        "accordion_block_3_0": {
          "type": "text",
          "settings": {
            "title": "Do you offer warranty for your products?",
            "text": "<p>Yes we offer warranty for manufacturing defects only. <br/><br/>It does not cover improper use, damage caused by your dog, or other issues that are not attributable to a manufacturer defects.<br/><br/>Please learn more about our warranty policy <a href=\"https://koozipets.com.au/pages/warranty-and-returns\" target=\"_blank\" title=\"https://koozipets.com.au/pages/warranty-and-returns\">here</a>.</p>"
          }
        },
        "accordion_block_3_1": {
          "type": "text",
          "settings": {
            "title": "What do I do if my product has arrived damaged?",
            "text": "<p>All Koozi products undergo quality control. However, if you receive a product with a manufacturing defect, we will replace or repair it at no cost to you. To benefit from this policy, please contact us within 48 hours of delivery to report the issue.</p><p>Email us at <a>help@koozipets.com.au</a> and include :</p><ul><li>\"Warranty/Product Issue Enquiry\" in the subject line </li><li>Include  your order number. </li><li>Attach photos or videos showing the damage or fault </li><li>A detailed description. </li></ul><p>We'll respond within one business day to guide you through the process and work with you to find a satisfactory solution.</p>"
          }
        },
        "accordion_block_3_2": {
          "type": "text",
          "settings": {
            "title": "Do you offer returns and refunds?",
            "text": "<p><strong>Beds and Sofa Toppers</strong>: Unopened and unused items may be returned within <strong>7  days of receipt </strong>for a full refund or exchange. You are responsible for the cost and arrangement of return shipping.<br/><br/>Please learn more <a href=\"https://koozipets.com.au/pages/warranty-and-returns\" target=\"_blank\" title=\"https://koozipets.com.au/pages/warranty-and-returns\">here</a>.</p><p><strong>New York Marble Bowl Set</strong>: This product is a limited edition, so sale is final. This excludes warranty-related issues.</p><p><strong>Koozi Side Table Crate</strong>: Due to their size as large furniture items, we are unable to accept returns for change of mind or exchange.</p>"
          }
        },
        "text_7x3p4d": {
          "type": "text",
          "settings": {
            "title": "How do make a warranty claim?",
            "text": "<p>Upon receiving your item, please inspect it carefully.<br/><br/>If you notice any defects or damage contact us promptly at <a><strong>help@koozipets.com.au</strong></a>.<br/><br/>Include in the email:</p><ul><li>Clear photos</li><li>Detailed description of the issue</li><li>Your order number</li><li>Your full name and contact details<br/></li></ul><p>We’ll evaluate and address the issue with either a replacement or repair.</p>"
          }
        }
      },
