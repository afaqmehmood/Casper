    "section_image_with_text_nxfqDN": {
      "type": "section-image-with-text",
      "settings": {
        "section_height": "six-fifty-height",
        "layout": "inline",
        "image_location": "left",
        "image_width": "standard",
        "image": "shopify://shop_images/red_clay_linen_cloud_dog_bed_koozi.jpg",
        "subheading": "",
        "title": "<p>Why You'll Love our Linen Covers</p>",
        "heading_highlight_type": "circle",
        "highlight_color": "#d43747",
        "highlight_text_color": "#000000",
        "heading_size": 100,
        "content": "<p><strong>Breathable + Temperature Regulating<br/></strong>Linen is naturally breathable, promoting air circulation and moisture evaporation to keep your dog cool in warm weather, while also offering insulation in cooler weather.<br/><br/></p><p><strong>Understated Elegance</strong></p><p>Our linen covers offer a relaxed, natural feel that come in a range of natural, soft earthy tones to compliment your living spaces.<br/><strong><br/>Durable Fabric</strong></p><p>Linen is naturally strong, and when blended with performance fabrics, it becomes more durable. It's more touch against everyday use, and resistant to scratching and digging - extending the lifespan of your dog's bed.</p>",
        "text_alignment": "left",
        "button_text": "",
        "button_link": "",
        "button_color": "btn--black",
