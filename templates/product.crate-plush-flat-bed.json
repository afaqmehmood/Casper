          }
        },
        "text_block_YdNERX": {
          "type": "text_block",
          "settings": {
            "image": "shopify://shop_images/crate_-_marble_detail_6d70146e-e2a1-4785-b3c2-f82d521ae5aa.jpg",
            "title": "Sleek Carrara Marble Style Top",
            "text": "<p>The Carrara marble-style top is visually stunning, showcasing a sleek, minimalist design. It’s lightweight, easier to clean, and more resistant to stains by using engineered materials instead of natural stone, combining beauty and safety with everyday practicality.</p>",
            "button_text": "",
            "button_link": "",
            "button_color": "btn--black",
            "button_style": "btn--text",
            "button_size": "btn--small",
            "video_link_popup": "",
