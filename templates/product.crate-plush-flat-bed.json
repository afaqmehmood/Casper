        "text_block_LPpyEb": {
          "type": "text_block",
          "settings": {
            "image": "shopify://shop_images/cody-medium-crate.png",
            "title": "A Stylish Table and Dog Crate or Den in One",
            "text": "<p>Seamlessly integrates into your living room or bedroom, offering a stylish, functional alternative that’s built to last for your dog’s lifetime.</p>",
            "button_text": "",
            "button_link": "",
            "button_color": "btn--black",
