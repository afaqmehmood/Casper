          }
        },
        "text_block_XHjLGy": {
          "type": "text_block",
          "settings": {
            "image": "shopify://shop_images/Medium_crate_side_on.jpg",
            "title": "Enhanced Airflow Design",
            "text": "<p>Three rows of elongated air holes on each side provide optimal airflow, ensuring your pet stays comfortable at all times. During warmer months, you can place a fan beside the crate to enhance cool air circulation.</p>",
            "button_text": "",
            "button_link": "",
            "button_color": "btn--black",
