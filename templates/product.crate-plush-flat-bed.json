        },
        "product_accordion_kBBMyw": {
          "type": "product_accordion",
          "settings": {
            "accordion_heading": "Details and Care",
            "heading_style": "font-body",
            "accordion_text": "<h6>Koozi Side Table Crate</h6><p><strong>Features:</strong></p><ul><li><strong>2-in-1 Side Table and Crate:</strong> A stylish and functional design that doubles as a side table and a dog crate.</li><li><strong>Stunning Carrara Marble Style & Elm Wood Finish:</strong> A modern and beautiful look that complements your home’s aesthetic.</li><li><strong>Innovative Transparent Pocket Door:</strong> Allows for flexible use as a dog den or crate for training.</li><li><strong>Sleek Functional Details:</strong> Double gold brass locks and rubber grip feet for added stability and style.</li><li><strong>Built for Small to Medium Dogs:</strong> Compact yet spacious, designed to fit perfectly into modern home interiors.</li><li><strong>Optimized Airflow:</strong> Elongated air holes ensure proper ventilation and comfort for your pet.</li><li><strong>Scratch-Proof Interior:</strong> Interior finish resists scratches, keeping the crate looking pristine.</li><li><strong>Rubber Feet for Grip:</strong> Protects your floors by preventing scratches and ensuring stability.</li><li><strong>Flat-Packed & Simple Assembly:</strong> Easy to assemble with minimal effort, ensuring a hassle-free setup.</li><li><strong>Weight:</strong> Small Size: 24kg | Medium Size: 34kg</li><li><strong>Care: </strong>Use mild spray and wipe or a damp cloth to clean dirt, marks and dust</li></ul><p></p><h6>Plush Bed</h6><ul><li>CertiPUR-US certified memory foam</li><li>Upholstery linen or boucle fabric cover</li><li>Waterproof Liner</li><li>Machine washable cover</li><li>OEKO-TEX Standard 100 certified</li><li><strong>Care</strong>: Wash with cold water or on a low temperature, using a gentle spin cycle. Line dry when possible</li></ul>",
            "accordion_page": "",
            "padding_bottom": 20
          }
        },
        "divider_PbxWhQ": {
          "type": "divider",
          "settings": {
