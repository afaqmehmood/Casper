          }
        },
        "text_block_QyQttt": {
          "type": "text_block",
          "settings": {
            "image": "shopify://shop_images/Side_Table_Crate_Medium_Size_Boucle_Bed.jpg",
            "title": "Durable Elm Wood Grain Structure",
            "text": "<p>The exterior and interior structure showcases the natural beauty of light elm wood grain, combined with the strength of engineered materials. This scratch-resistant design offers an organic look that’s built to last.</p>",
            "button_text": "",
            "button_link": "",
            "button_color": "btn--black",
            "button_style": "btn--text",
            "button_size": "btn--small",
            "video_link_popup": "",
