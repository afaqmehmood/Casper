          "settings": {
            "image": "shopify://shop_images/brass_lock_detail.jpg",
            "title": "Two Gold Brass Locks",
            "text": "<p>The door is equipped with two elegant gold brass locks that slide up and down into a recessed hole in the base panel. This sophisticated design caters to dog parents who crate train or use for overnight sleep.</p>",
            "button_text": "",
            "button_link": "",
            "button_color": "btn--black",
