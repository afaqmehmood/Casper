        },
        "text_block_T3JzQN": {
          "type": "text_block",
          "settings": {
            "image": "shopify://shop_images/sliding_door.jpg",
            "title": "Versatile Sliding Transparent Pocket Door",
            "text": "<p>The transparent acrylic door can slide up and inwards to be hidden, or can be pulled down to close. It provides versatile use as a cosy den or for crate training.</p>",
            "button_text": "",
            "button_link": "",
            "button_color": "btn--black",
