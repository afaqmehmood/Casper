          "settings": {
            "accordion_heading": "Materials",
            "heading_style": "font-body",
            "accordion_text": "<h6><strong>Designed in Sydney, Australia</strong><br/><br/>Koozi Side Table Crate</h6><ul><li><strong>Premium Surface Top:</strong> Water-resistant with a white Carrara marble-textured finish.</li><li><strong>Durable Construction:</strong> Engineered elm-grain plywood, offering strength and aesthetic appeal.</li><li>Brass locks </li><li>Transparent acrylic door</li></ul><h6>Plush Bed</h6><p><strong>Mattress</strong></p><ul><li>Supportive orthopaedic memory foam base layer with a cooling gel memory foam top layer</li><li>Waterproof inner liner</li></ul><p><strong>Fabric Cover (two options)</strong></p><ul><li> Linen fabric: An upholstery-grade natural linen and performance polyester blend. GSM: 480gsm</li><li>Boucle fabric: Upholstery grade acrylic-cotton blend. GSM: 600gsm</li><li>OEKO-TEX Certified (no nasties)</li></ul>",
            "accordion_page": "",
            "padding_bottom": 20
