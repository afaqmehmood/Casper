        "text_EnHxLW": {
          "type": "text",
          "settings": {
            "title": "Do you offer warranty for your products?",
            "text": "<p>All our products are subject to quality control.<br/><br/>Our warranty provides a guarantee against manufacturer defects.<br/><br/>The warranty covers any manufacturing, design, or material defect. <br/><br/>It does not cover blows, improper use, or other issues that are not attributable to a manufacturer defects.</p><p>Please read more <a href=\"/pages/warranty-and-returns\" title=\"Warranty & Returns\">here</a></p>"
