        "text_i6jthf": {
          "type": "text",
          "settings": {
            "title": "How do I assemble my Koozi products?",
            "text": "<p><strong>Side Table Crate:</strong> It will be delivered to you flat-packed, and will require a 15 minute assembly. <br/><br/><strong>Beds: </strong>Beds are compression packed for ease of delivery to you. Simply unbox the bed, and it will expand. no need for assembly. <br/><br/><strong>Sofa Topper: </strong>They also are delivered to you in a compression pack. Simply unseal the packaging and it will expand. </p>"
          }
