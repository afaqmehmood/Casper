          "type": "text_block",
          "settings": {
            "image": "shopify://shop_images/KOOZI-STUDIO-332.jpg",
            "title": "New Space-Enhancing Half Bolster Design",
            "text": "<p>Our Cloud Bed combines plush memory foam comfort with orthopedic joint support, featuring a half-bolster pillow design that maximises space, allowing dogs to fully stretch out in their natural sleeping position. </p>",
            "button_text": "",
            "button_link": "",
