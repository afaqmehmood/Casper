        "text_block_kKGmzc": {
          "type": "text_block",
          "settings": {
            "image": "shopify://shop_images/Cloudbed_small-boucle1_9788a920-21b6-42a1-86d3-b5e3e995c063.jpg",
            "title": "The Perfect Memory Foam pillow",
