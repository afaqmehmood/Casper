    "section_image_with_text_xTac4H": {
      "type": "section-image-with-text",
      "settings": {
        "section_height": "five-fifty-height",
        "layout": "inline",
        "image_location": "left",
        "image_width": "standard",
        "image": "shopify://shop_images/Boucle-cloud-bed-bailey-koozi.jpg",
        "subheading": "",
        "title": "",
        "heading_highlight_type": "circle",
        "highlight_color": "#d43747",
        "highlight_text_color": "#000000",
        "heading_size": 130,
        "content": "<h1>Why You'll Love Our Buttercream Boucle Fabric Cover<br/> <br/></h1><p><strong>Elevated and Timeless Style</strong></p><p>Our Cloud Bed in Buttercream Boucle fabric offers seamless integration into any home. With its neutral creamy tone and plush, luxurious texture, its the ultimate cosy retreat for your dog.<br/><br/></p><p><strong>Thick and Durable Fabric</strong></p><p>Crafted with heavy 600 GSM upholstery-grade boucle the same quality used for human sofas - it ensures unmatched quality and style for your home, and your dog's ultimate comfort. Plus its machine washable.<br/><br/></p><p><strong>Cosy and Snug Texture</strong></p><p>The boucle texture offers a snug, cosy feel that’s perfect for any time of year, especially during cooler evenings. Its inviting design encourages your dog to curl up and relax while adding a stylish touch to your living room or bedside interiors.</p>",
        "text_alignment": "left",
